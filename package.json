{
  "name": "aureumvellum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles/tailwind.css -o ./public/styles.css --minify && tailwindcss -i ./src/styles/admin-tailwind.css -o ./src/app/admin-tailwind.generated.css --minify",
    "dev:styles": "tailwindcss -i ./src/styles/tailwind.css -o ./public/styles.css --watch",
    "dev:admin-styles": "tailwindcss -i ./src/styles/admin-tailwind.css -o ./src/app/admin-tailwind.generated.css --watch",
    "predev": "npm run build:styles",
    "prebuild": "npm run build:styles",
    "dev": "next dev --webpack -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3000}",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "graphql": "^16.8.1",
    "next": "16.2.3",
    "payload": "3.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
